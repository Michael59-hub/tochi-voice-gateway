# Database Configuration (Used by docker-compose)
DB_USER=postgres
DB_PASSWORD=your_secure_password_here
DB_NAME=tochi_voice
DB_PORT=5432

# Prisma Connection URL (WSL/Host machine -> Docker Postgres)
DATABASE_URL="postgresql://postgres:your_secure_password_here@localhost:5432/tochi_voice?schema=public"

# Application Configuration
JWT_SIGNING_SECRET=generate_a_random_32_character_secret
PORT=3000
ADMIN_PORT=4000
NODE_ENV=development
REQUEST_FINGERPRINT_SECRET=generate_a_random_32_character_secret
ADMIN_API_SECRET=generate_a_random_32_character_secret
VOICE_PROVIDER_MODE="mock"

SAHARA_API_URL="tobeadded"
SAHARA_API_KEY="tobeadded"
VOICE_PROVIDER_MODE=mock